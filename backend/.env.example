# Copy to backend/.env for local development. Never commit the real .env.
# All variables are documented in SPEC.md section 12.1.

# LLM (OpenAI)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4-mini

# MongoDB (local service on Windows, or an Atlas connection string in production)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bright_smile
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Staff auth
# SESSION_SECRET: at least 32 random characters, e.g. `uv run python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=replace-with-at-least-32-random-characters
# STAFF_PASSWORD_HASH: Argon2 hash from `uv run python -m bright_smile.cli hash-password` (available from issue #9)
STAFF_PASSWORD_HASH=replace-me

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
