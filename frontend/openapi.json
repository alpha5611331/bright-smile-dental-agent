{
  "openapi": "3.1.0",
  "info": {
    "title": "Bright Smile Dental AI Front Desk API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service and database health",
        "operationId": "health-get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Send a message and stream the assistant's reply",
        "operationId": "chat-post_chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired id",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Turn limit reached",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leads": {
      "post": {
        "tags": [
          "leads"
        ],
        "summary": "Submit an appointment request from the form fallback",
        "operationId": "leads-post_lead",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadCreated"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Omit to start a new conversation; reuse the id from `conversation`."
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "DependencyStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "DependencyStatus"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_error",
          "unauthorized",
          "not_found",
          "rate_limited",
          "conversation_limit",
          "upstream_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          },
          "db": {
            "$ref": "#/components/schemas/DependencyStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db"
        ],
        "title": "HealthResponse"
      },
      "Interest": {
        "type": "string",
        "enum": [
          "new_patient_exam",
          "cleaning",
          "filling",
          "crown",
          "whitening",
          "invisalign",
          "implant",
          "emergency",
          "insurance_question",
          "other"
        ],
        "title": "Interest"
      },
      "LeadCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "Visitor's full name"
          },
          "phone": {
            "type": "string",
            "format": "phone",
            "title": "Phone",
            "description": "US phone number the front desk should call"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Visitor's email address"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "description": "Reason for the visit, in the visitor's words"
          },
          "preferred_location": {
            "$ref": "#/components/schemas/PreferredLocation",
            "description": "Preferred office: bethesda, rockville, or no_preference"
          },
          "patient_type": {
            "$ref": "#/components/schemas/PatientType",
            "description": "new or existing patient, if known",
            "default": "unknown"
          },
          "interest": {
            "$ref": "#/components/schemas/Interest",
            "description": "Closest match to what the visitor wants",
            "default": "other"
          },
          "contact_consent": {
            "type": "boolean",
            "title": "Contact Consent",
            "description": "True only if the visitor explicitly agreed to be contacted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "phone",
          "email",
          "reason",
          "preferred_location",
          "contact_consent"
        ],
        "title": "LeadCreate",
        "description": "A validated appointment request."
      },
      "LeadCreated": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          }
        },
        "type": "object",
        "required": [
          "id",
          "priority"
        ],
        "title": "LeadCreated"
      },
      "PatientType": {
        "type": "string",
        "enum": [
          "new",
          "existing",
          "unknown"
        ],
        "title": "PatientType"
      },
      "PreferredLocation": {
        "type": "string",
        "enum": [
          "bethesda",
          "rockville",
          "no_preference"
        ],
        "title": "PreferredLocation"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "P1",
          "P2",
          "P3",
          "P4"
        ],
        "title": "Priority",
        "description": "Callback order: P1 first. String values sort in priority order."
      },
      "ServiceStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded"
        ],
        "title": "ServiceStatus"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}
